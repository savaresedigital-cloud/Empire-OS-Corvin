# Facoltativo: la versione locale parte senza questo file o credenziali.
# Copiare in .env. Il processo Node lo legge; il client non deve ricevere segreti.

# API locale. Il proxy Vite punta a 127.0.0.1:8787.
# Se si cambia API_PORT, aggiornare anche vite.config.js.
API_HOST=127.0.0.1
API_PORT=8787

# Origini esatte separate da virgole; niente wildcard.
# Per il deployment impostare l'origine HTTPS effettiva del frontend.
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Solo server. Una chiave senza token Firebase valido non apre l'endpoint AI.
# La UI Finanze include accesso Firebase e selezione Gemini quando configurati.
GEMINI_API_KEY=

# Default attuale del codice, configurabile.
# Verificare disponibilita, quota e costi nel proprio account prima dell'uso.
# Questo valore non dichiara una chiamata remota collaudata.
GEMINI_MODEL=gemini-2.5-flash-lite

# Progetto Firebase per la verifica server dei token ID.
# Configurare anche le due variabili pubbliche VITE_FIREBASE_* e pubblicare firestore.rules.
FIREBASE_PROJECT_ID=

# Facoltativo se l'hosting fornisce gia Application Default Credentials.
# Altrimenti usare un percorso assoluto al file privato delle credenziali,
# conservato fuori dalla cartella condivisa, dal repository e dallo ZIP.
# Su Windows un percorso puo usare slash: C:/percorso-privato/account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Configurazione pubblica client per accesso/snapshot Firestore facoltativi.
# Non inserire chiavi Gemini né service account con prefisso VITE_.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
# URL del backend Node autenticato (HTTPS in produzione), facoltativo.
VITE_API_BASE_URL=
