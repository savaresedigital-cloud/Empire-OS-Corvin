# Copia i valori nel pannello Hostinger. Nessuna credenziale va in GitHub.
NODE_ENV=production
APP_ORIGIN=https://app.esempio.it
PORT=3000

# Database MySQL: le credenziali del database creato nel tuo piano.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# true per database remoti che richiedono TLS; verifica nel pannello del fornitore.
DB_SSL=false

# Genera questi due valori con npm run setup:owner, sul tuo PC.
EMPIRE_OWNER_PASSWORD_HASH=
EMPIRE_SESSION_SECRET=

# Progetto Google Cloud. Il modello è configurabile sul server.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite

# Autenticazione ADC del server: percorso privato fuori da repository e build.
# Preferire Workload Identity Federation dove disponibile. Se viene usato un
# service account, usare un accesso dedicato con i soli permessi necessari.
# Non trasferire l'ADC personale del PC sul server.
GOOGLE_APPLICATION_CREDENTIALS=
