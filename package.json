{
  "name": "empire-os",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build && node scripts/finalize-pwa.mjs && node scripts/build-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "start:hostinger": "node server.js",
    "start:demo": "node scripts/preview-real-data.mjs",
    "build:archive": "node scripts/build-unified-archive.mjs",
    "setup:owner": "node scripts/configure-owner.mjs",
    "import:private": "node --env-file-if-exists=.env scripts/import-private.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "google-auth-library": "^11.3.0",
    "mysql2": "^3.24.5",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "optionalDependencies": {
    "firebase-admin": "^14.5.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
